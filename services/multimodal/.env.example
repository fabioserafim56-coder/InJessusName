# Generate a private, high-entropy token outside the repository.
INJESSUS_MULTIMODAL_SERVICE_TOKEN=
INJESSUS_OCR_ENABLED=1
INJESSUS_OCR_CPU_THREADS=2

# Vision is disabled until its infrastructure/provider is configured.
INJESSUS_VISION_ENABLED=0
INJESSUS_VISION_PROVIDER=qwen-local
INJESSUS_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
INJESSUS_VISION_REVISION=cc594898137f460bfe9f0759e9844b3ce807cfb5
INJESSUS_VISION_DEVICE=auto

# Alternative: an existing OpenAI-compatible image-input service.
# INJESSUS_VISION_PROVIDER=openai-compatible
# INJESSUS_VISION_BASE_URL=https://your-provider.example/v1
# INJESSUS_VISION_API_KEY=
# INJESSUS_VISION_MODEL=your-actual-vision-model
