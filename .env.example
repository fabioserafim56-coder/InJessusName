# A apresentação pública funciona sem credenciais. Contas e perfil salvo precisam desta configuração.
# No desenvolvimento local: npm run db:start, npm run db:env e npm run db:migrate.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nunca coloque chaves administrativas, service_role ou senhas em NEXT_PUBLIC_*.

# Análise visual opcional do museu: configuração privada do servidor Next.js.
# Escolha explícita: openai, gemini ou qwen. Vazio não seleciona um provedor cloud.
# APIs comerciais ficam desligadas por padrão. Ative com 1 somente com orçamento definido.
INJESSUS_ENABLE_PAID_VISION=0
INJESSUS_VISION_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Overrides opcionais; vazios usam gpt-6-luna (OpenAI) ou gemini-3.8-flash (Gemini).
INJESSUS_OPENAI_VISION_MODEL=
INJESSUS_GEMINI_VISION_MODEL=

# Serviço privado opcional para Qwen/PaddleOCR; HTTPS e token fora do loopback.
# Sem provedor explícito, um serviço privado válido continua sendo usado para visão.
INJESSUS_MULTIMODAL_SERVICE_URL=
INJESSUS_MULTIMODAL_SERVICE_TOKEN=

# Use chaves novas, guardadas no painel do provedor ou em .env.local fora do Git.
# Nunca use NEXT_PUBLIC_ para estas chaves. Guia: docs/configurar-visao.md.
