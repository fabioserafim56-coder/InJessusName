# A apresentação pública funciona sem credenciais. Contas e perfil salvo precisam desta configuração.
# No desenvolvimento local: npm run db:start, npm run db:env e npm run db:migrate.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nunca coloque chaves administrativas, service_role ou senhas em NEXT_PUBLIC_*.
